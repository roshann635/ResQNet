# ResQNet Academic Simulation Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/resqnet

# Authentication Configuration (JWT)
JWT_SECRET=resqnet-academic-dsa-secret-key-eval-2026-super-secure
JWT_EXPIRES_IN=24h

# Deterministic PRNG Seed (Fixed for reproducibility)
PRNG_SEED=1337

# Algorithm & Scoring Parameters
DEFAULT_CONGESTION_MULTIPLIER=1.8
SCORING_WEIGHT_ROUTE_COST=0.40
SCORING_WEIGHT_UTILIZATION=0.25
SCORING_WEIGHT_CAPABILITY=0.20
SCORING_WEIGHT_RELIABILITY=0.15

# Default Search Bounds
DEFAULT_MAX_HOPS=12
DEFAULT_MAX_COST=60.0
DEFAULT_MAX_RESULTS=5
MAX_GRAPH_NODES=2000
