{
  "name": "resqnet",
  "version": "1.0.0",
  "description": "ResQNet: DSA-Based Emergency Response & Route Optimization (Academic Simulation)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "data:generate": "node data/generator/generate.js",
    "data:validate": "node data/generator/validate.js",
    "seed": "npm run seed --workspace=server",
    "seed:reset": "npm run seed:reset --workspace=server",
    "seed:city": "npm run seed:city --workspace=server",
    "seed:large": "npm run seed:large --workspace=server",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server",
    "build": "npm run build --workspace=client"
  },
  "keywords": [
    "dsa",
    "graph",
    "dijkstra",
    "astar",
    "emergency-response",
    "route-optimization",
    "minheap",
    "bplus-tree"
  ],
  "author": "Computer Engineering PBL Team",
  "license": "MIT",
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
